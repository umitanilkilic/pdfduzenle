# Copy to .env; docker compose reads it automatically.

# Unlimited-OCR endpoint (OpenAI-compatible, e.g. vLLM/SGLang on a rented GPU).
# Leave empty to run OCR with Tesseract only.
UNLIMITED_OCR_BASE_URL=
UNLIMITED_OCR_API_KEY=
UNLIMITED_OCR_MODEL=Unlimited-OCR

# Analytics (optional; empty = off). Only for local builds (docker compose up -d --build): production
# images are built by the release workflow from the repository variables of the same names.
# Google Analytics 4 measurement ID (G-...) and Microsoft Clarity project ID.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=

# Search engine site verification tokens (the content="..." value of their meta tag).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
